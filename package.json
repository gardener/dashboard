{
  "name": "gardener-dashboard",
  "description": "Gardener Dashboard",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*",
    "charts"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gardener/dashboard.git",
    "directory": "."
  },
  "contributors": [
    "Gross, Lukas <lukas.gross@sap.com>",
    "Koser, Holger <holger.koser@sap.com>",
    "Sutter, Peter <peter.sutter@sap.com>"
  ],
  "scripts": {
    "lint:hack": "eslint --config hack/eslint.config.cjs hack/eslint.config.cjs hack/local-dashboard.mjs hack/local-dashboard",
    "lint:hack:sarif": "yarn lint:hack --format=@microsoft/eslint-formatter-sarif",
    "test:hack": "vitest run --config hack/local-dashboard/vitest.config.mjs",
    "test:hack:cov": "yarn test:hack --coverage",
    "serve": "yarn workspaces foreach --all --parallel --interlaced --include '@gardener-dashboard/frontend' --include '@gardener-dashboard/backend' run serve",
    "packages-test-all": "yarn workspaces foreach --all --parallel --no-private --include 'packages/*' run test",
    "packages-lint-all": "yarn workspaces foreach --all --parallel --no-private --include 'packages/*' run lint",
    "postinstall": "[ ! -f .husky/user-config ] || grep -q '^managed_hooks=true$' .husky/user-config && husky || echo '[husky] Skipping husky install due to user preference.'"
  },
  "dependenciesMeta": {
    "deasync": {
      "built": false
    },
    "fsevents": {
      "built": false
    }
  },
  "devDependencies": {
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/eslint-plugin": "^1.6.15",
    "eslint": "^10.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "neostandard": "^0.13.0",
    "vitest": "^4.0.0"
  },
  "bin": {
    "update-prod-install": "./scripts/update-prod-install.cjs"
  },
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": "24.19.0"
  },
  "dependencies": {
    "lodash-es": "^4.17.21"
  },
  "resolutions": {
    "@vue/server-renderer": "3.5.42"
  }
}
